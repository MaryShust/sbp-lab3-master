      <bpmn:outgoing>Flow_04xigzu</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rq2ngo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0yahlzm" sourceRef="Activity_0wponer" targetRef="Gateway_1bzrylb" />
    <bpmn:serviceTask id="Activity_01nuie7" name="Создание счета" camunda:class="com.example.sbp.delegate.CreateBillDelegate">
      <bpmn:incoming>Flow_04xigzu</bpmn:incoming>
      <bpmn:outgoing>Flow_1fva0s3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_04xigzu" sourceRef="Gateway_1bzrylb" targetRef="Activity_01nuie7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasPrivilege == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1w5mv0g" name="Проверка результата" camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_1fva0s3</bpmn:incoming>
      <bpmn:incoming>Flow_0rq2ngo</bpmn:incoming>
      <bpmn:outgoing>Flow_0t0x97d</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1fva0s3" sourceRef="Activity_01nuie7" targetRef="Activity_1w5mv0g" />
    <bpmn:sequenceFlow id="Flow_0rq2ngo" sourceRef="Gateway_1bzrylb" targetRef="Activity_1w5mv0g">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasPrivilege == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_17au1vp" name="Конец">
      <bpmn:incoming>Flow_0t0x97d</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0t0x97d" sourceRef="Activity_1w5mv0g" targetRef="Event_17au1vp" />
  </bpmn:process>
