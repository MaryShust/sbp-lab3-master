  <bpmn:process id="create-bill-process" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_1" name="Старт">
      <bpmn:extensionElements>
        <camunda:executionListener class="com.example.sbp.delegate.AssignInitiatorListener" event="start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1e0sixl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1tjrl8i" name="Ввод данных" camunda:formRef="create-bill" camunda:formRefBinding="latest" camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_1e0sixl</bpmn:incoming>
      <bpmn:outgoing>Flow_07v4dxl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1e0sixl" sourceRef="StartEvent_1" targetRef="Activity_1tjrl8i" />
    <bpmn:serviceTask id="Activity_0wponer" name="Проверка прав" camunda:class="com.example.sbp.delegate.CheckPrivilegeCreateBillDelegate">
